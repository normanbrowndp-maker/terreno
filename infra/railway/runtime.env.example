# NON-SECRET TEMPLATE ONLY. No service or deployment has been created.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
RAILPACK_NODE_VERSION=26.13.1
RAILPACK_NODE_NPM_INSTALL="npm ci"
# PORT must be injected by Railway into the process, not loaded from an env file.
# These blanks intentionally keep the application not ready; no URL is invented.
DATABASE_URL=
TRAVEL_DATABASE_PROFILE=
TRAVEL_DATABASE_ID=
# External PostgreSQL needs a separately approved strict profile, endpoint,
# TLS verify-full/CA, identity marker and runtime ACL verification first.
# Do not put migration/bootstrap credentials in the application service.
