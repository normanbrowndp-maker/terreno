{
  "name": "travel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^24.0.0 || ^26.0.0", "npm": ">=11 <12" },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:bootstrap:local": "vitest run --config vitest.bootstrap.config.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:dependencies": "tsx scripts/check-dependencies.ts",
    "check:docs": "python -B docs/audit/verify_stage1.py",
    "check": "npm run lint && npm run typecheck && npm run check:architecture && npm run check:secrets && npm run check:docs && npm run check:dependencies && npm run test:unit && npm run test:integration && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:demo": "tsx scripts/seed-italy.ts",
    "db:local": "tsx scripts/local-database.ts",
    "db:download": "powershell -NoProfile -File scripts/install-portable-postgres.ps1",
    "db:restore-check": "tsx scripts/verify-restore.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "node-pg-migrate": { "glob": "14.0.6" }
  }
}
